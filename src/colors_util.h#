pub fn strip(s: string) -> string is
    let n: int = string_len(s)
    let mut out: string = ""
    let mut i: int = 0
    let mut start: int = 0
    while i < n is
        if string_slice(s, i, i + 1) == "\x1b" && i + 1 < n && string_slice(s, i + 1, i + 2) == "[" is
            out = out + string_slice(s, start, i)
            i = i + 2
            ;; parameter / intermediate bytes 0x20-0x3f, then one final byte 0x40-0x7e
            let mut done: bool = false
            while i < n && !done is
                let c: string = string_slice(s, i, i + 1)
                i += 1
                if string_find("@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", c) >= 0 is
                    done = true
                end
            end
            start = i
        else is
            i += 1
        end
    end
    out = out + string_slice(s, start, n)
    return out
end

;; true when the text contains an escape sequence
pub fn is_colored(s: string) -> bool is
    return string_contains(s, "\x1b[")
end

;; Size in bytes of the UTF-8 character that starts at byte `i`.
;; (The LLVM backend has no `string.chars()` method, so text is walked with
;; string_slice + the lead byte instead.)
pub fn char_size_at(s: string, i: int) -> int is
    let lead: int = __builtin_str_to_char_code(string_slice(s, i, i + 1))
    if lead < 192 is return 1 end
    if lead < 224 is return 2 end
    if lead < 240 is return 3 end
    return 4
end

;; Split text into characters (UTF-8 aware) -- works in every backend.
pub fn chars(s: string) -> [string] is
    let n: int = string_len(s)
    let mut out: [string] = []
    let mut i: int = 0
    while i < n is
        let size: int = char_size_at(s, i)
        out.push(string_slice(s, i, i + size))
        i = i + size
    end
    return out
end

;; Number of characters in the text (UTF-8 aware, escape codes NOT removed).
pub fn char_count(s: string) -> int is
    let n: int = string_len(s)
    let mut count: int = 0
    let mut i: int = 0
    while i < n is
        i = i + char_size_at(s, i)
        count += 1
    end
    return count
end

;; Number of characters you actually see (escape codes removed, UTF-8 aware).
pub fn visible_len(s: string) -> int is
    return char_count(strip(s))
end

;; Cut to at most `width` visible characters.  Colour codes are dropped from the
;; result when the text has to be shortened, so no escape sequence is ever split.
pub fn truncate(s: string, width: int) -> string is
    if visible_len(s) <= width is return s end
    let cs: [string] = chars(strip(s))
    let mut out: string = ""
    let mut i: int = 0
    while i < width && i < array_len(cs) is
        out = out + cs[i]
        i += 1
    end
    return out
end

;; Pad to `width` visible characters (colour codes do not count).
pub fn pad_right(s: string, width: int) -> string is
    let n: int = visible_len(s)
    if n >= width is return s end
    return s + string_repeat(" ", width - n)
end

pub fn pad_left(s: string, width: int) -> string is
    let n: int = visible_len(s)
    if n >= width is return s end
    return string_repeat(" ", width - n) + s
end

pub fn center(s: string, width: int) -> string is
    let n: int = visible_len(s)
    if n >= width is return s end
    let total: int = width - n
    let left: int = total / 2
    return string_repeat(" ", left) + s + string_repeat(" ", total - left)
end
